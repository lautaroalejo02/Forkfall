diff --git a/public/js/lib/quantity.js b/public/js/lib/quantity.js
index c586f2d..56c127a 100644
--- a/public/js/lib/quantity.js
+++ b/public/js/lib/quantity.js
@@ -2,5 +2,10 @@ export function configureQuantity(input, quantity, product) {
   input.min = '1';
   input.max = String(product.stock);
   input.step = '1';
-  input.value = String(quantity);
+  const key = `shop-quantity-${product.id}`;
+  const saved = Number(sessionStorage.getItem(key));
+  input.value = String(Number.isInteger(saved) && saved >= 1 && saved <= product.stock ? saved : quantity);
+  input.addEventListener('change', () => {
+    if (input.validity.valid) sessionStorage.setItem(key, input.value);
+  });
 }
